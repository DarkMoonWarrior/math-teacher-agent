# Next.js 在服务器内部把同源 /api/v1 请求转发给 FastAPI。
# 浏览器无需直接连接 8000 端口；部署为分离容器时再覆盖此地址。
MATH_AI_API_INTERNAL_URL=http://127.0.0.1:8000

# Comma-separated browser origins accepted by FastAPI.
MATH_AI_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# M12 Closed Beta access. Keep the real roster only in a private deployment
# environment. Production HTTPS deployments must enable secure cookies.
MATH_AI_BETA_ACCESS_ENABLED=false
# Participant objects contain teacher_id, display_label and an allow-listed
# capabilities array. Keep real access codes out of Git.
MATH_AI_BETA_ACCESS_ROSTER_JSON={}
MATH_AI_BETA_SESSION_TTL_HOURS=12
MATH_AI_BETA_SESSION_SECURE_COOKIE=false
# M13 指标与访问门禁分开启用；真实密钥只放私有部署环境，至少 32 个字符。
# 教师仍须在页面确认当前告知版本后才会开始记录无正文指标。
MATH_AI_BETA_VALIDATION_ENABLED=false
MATH_AI_BETA_VALIDATION_IDENTITY_SECRET=
MATH_AI_BETA_VALIDATION_RETENTION_DAYS=90

# M14 正式身份基础。与 MATH_AI_BETA_ACCESS_ENABLED 互斥；当前默认关闭。
# SQLite 仅为过渡 adapter，不能被当作生产多租户数据库。
MATH_AI_PRODUCTION_IDENTITY_ENABLED=false
MATH_AI_PRODUCTION_IDENTITY_DB=data/private-runtime/account-identity.sqlite3
MATH_AI_PRODUCTION_SESSION_TTL_HOURS=12
MATH_AI_PRODUCTION_SESSION_COOKIE_NAME=math_ai_account_session
MATH_AI_PRODUCTION_SESSION_SECURE_COOKIE=true
# M12 私有备份目的地；生产 Beta 必须改为加密私有卷或等效受保护挂载点。
# 备份 CLI 仍要求每次显式传入 --confirm-private-storage。
MATH_AI_BETA_BACKUP_DIR=data/private-runtime/backups

# Override only when the curriculum CSV is moved.
MATH_AI_CURRICULUM_CSV=docs/high-school-math-ai/curriculum/pep-a-full-knowledge-tree-v1.csv

# 题目配图本地存储目录；运行时文件不会提交到 Git。
MATH_AI_QUESTION_MEDIA_DIR=data/runtime/question-media
# 教师私人资料元数据与原文件；默认不进入公共检索或训练。
MATH_AI_PRIVATE_LIBRARY_DB=data/runtime/private-library.sqlite3
MATH_AI_PRIVATE_LIBRARY_DIR=data/runtime/private-library-files
# M8 辅助命制题使用独立 owner-only 存储，不与公共 QuestionBank 共库。
MATH_AI_PERSONAL_QUESTION_LIBRARY_DB=data/private-runtime/personal-question-library.sqlite3
# 结构化命题草稿默认在配置 DeepSeek Key 后使用模型；草稿不会自动保存。
MATH_AI_QUESTION_AUTHORING_PROVIDER=auto
# 试卷保存不可变题目快照；题干图片会复制到独立的试卷资产目录。
MATH_AI_EXAM_PAPER_ASSET_DIR=data/runtime/exam-paper-assets
# PDF 登记时按文件名读取首轮题量估计；找不到时保持为 0，等待分析结果。
MATH_AI_PDF_QUESTION_ESTIMATES_CSV=docs/high-school-math-ai/audits/batch-2026-08-001-question-estimates.csv

# 教案生成器默认使用本地模板，可在没有 API Key 时完整体验生成与编辑流程。
MATH_AI_LESSON_PLAN_PROVIDER=auto
# 题目变式默认在有 Key 时使用大模型，否则启用已验证单选题的本地错因诊断规则。
MATH_AI_QUESTION_VARIANT_PROVIDER=auto
# 解题助手优先匹配已验证题库；有 Key 时再处理题库外的新题和第二种解法。
MATH_AI_SOLUTION_PROVIDER=auto
MATH_AI_OPENAI_API_KEY=
MATH_AI_DEEPSEEK_API_KEY=
MATH_AI_DEEPSEEK_MODEL=deepseek-v4-flash
MATH_AI_DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
MATH_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
MATH_AI_OPENAI_MODEL=gpt-5.6-terra
MATH_AI_OPENAI_REASONING_EFFORT=low
MATH_AI_OPENAI_TIMEOUT_SECONDS=90

# 模型运行中心只保存运行元数据，不保存题目正文、提示词或 API Key。
MATH_AI_MODEL_OPERATIONS_DB=data/runtime/model-operations-v1.sqlite3
# 如需估算成本，请按供应商当前价目表填写每百万 token 的美元费率快照。
# 未填写时页面只展示 token 用量，避免使用过期价格。
# MATH_AI_OPENAI_INPUT_USD_PER_MILLION=
# MATH_AI_OPENAI_CACHED_INPUT_USD_PER_MILLION=
# MATH_AI_OPENAI_OUTPUT_USD_PER_MILLION=
# MATH_AI_DEEPSEEK_INPUT_USD_PER_MILLION=
# MATH_AI_DEEPSEEK_CACHED_INPUT_USD_PER_MILLION=
# MATH_AI_DEEPSEEK_OUTPUT_USD_PER_MILLION=

# 教案导出目录；PDF 中文字体通常可在 Windows/Linux 自动发现。
MATH_AI_LESSON_EXPORT_DIR=output
# Linux 镜像未安装 Noto Sans CJK 时，可显式指定常规体和粗体文件。
# MATH_AI_CJK_FONT_REGULAR=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# MATH_AI_CJK_FONT_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc

# ===== Teacher Agent Runtime =====
# 默认 legacy：不改任何配置时现有产品行为完全不变。
MATH_AI_AGENT_RUNTIME=legacy
# 显式允许 dsh 不可达时降级 legacy；默认 false（绝不静默降级，降级会写结构化日志）。
MATH_AI_AGENT_ALLOW_LEGACY_FALLBACK=false

# FastAPI -> Agent Service 的 M2M 令牌与地址（两个信任方向使用不同的 secret）。
MATH_AI_AGENT_SERVICE_URL=http://127.0.0.1:4100
MATH_AI_AGENT_SERVICE_TOKEN=
MATH_AI_AGENT_REQUEST_TIMEOUT_SECONDS=900

# Agent Service -> FastAPI Internal Tool Gateway 的 M2M 令牌。
# 该 token 只允许调用 /internal/agent-tools/v1/* 九个受控工具端点；
# 其中 create_question_draft 只返回未保存草稿，不执行业务写入。
MATH_AI_TOOL_GATEWAY_TOKEN=
MATH_AI_TOOL_GATEWAY_TIMEOUT_SECONDS=30
# 解题可能包含模型推理；仍由 FastAPI 硬超时保护，且不允许无限等待。
MATH_AI_SOLVE_TOOL_TIMEOUT_SECONDS=120
MATH_AI_QUESTION_AUTHORING_TOOL_TIMEOUT_SECONDS=900

# 以下变量只属于 apps/agent（Node Agent Service），绝不下发到浏览器。
# 默认 test-mock：无真实 API Key 时使用确定性 mock 模型（仅开发/测试）。
MATH_AI_AGENT_PROVIDER=test-mock
MATH_AI_AGENT_MODEL=mock-model
MATH_AI_AGENT_SESSION_ROOT=data/runtime/agent-sessions
MATH_AI_AGENT_TOOL_TIMEOUT_MS=30000
MATH_AI_AGENT_RUN_HARD_TIMEOUT_MS=900000
# 单次 run 内 search_questions 工具调用硬上限（Tool Loop / Cost Gate）
MATH_AI_SEARCH_TOOL_CALL_LIMIT=6
MATH_AI_AGENT_HOST=127.0.0.1
MATH_AI_AGENT_PORT=4100

# M8 切片 2 的公开辅助命题 workflow 默认关闭；只有启动 DSH/Tool Gateway 后再显式开启。
MATH_AI_QUESTION_AUTHORING_AGENT_ENABLED=false
# 真实 DeepSeek 接入时设置 MATH_AI_DEEPSEEK_API_KEY（见上方），并把 provider 改为：
# MATH_AI_AGENT_PROVIDER=deepseek-official

# 新 Teacher Web 的可信 Search Agent。默认代码配置为 false；本地启用时显式设为 true。
MATH_AI_SEARCH_AGENT_ENABLED=true
# M5 Solve workflow 独立开关；示例环境为本地联调显式开启，代码默认仍为 false。
MATH_AI_SOLVE_AGENT_ENABLED=true
MATH_AI_SEARCH_AGENT_MAX_QUERY_LENGTH=2000
