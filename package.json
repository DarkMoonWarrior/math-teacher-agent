{
  "name": "math-teacher-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:repo": "node scripts/check_repository_docs.mjs",
    "setup:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap_dev_env.ps1",
    "dev:teacher": "pnpm --filter @math-teacher-agent/teacher-web dev",
    "build:teacher": "pnpm --filter @math-teacher-agent/teacher-web build",
    "typecheck:teacher": "pnpm --filter @math-teacher-agent/teacher-web typecheck",
    "test:teacher": "pnpm --filter @math-teacher-agent/teacher-web test",
    "dev:web": "pnpm dev:teacher",
    "build:web": "pnpm build:teacher",
    "typecheck:web": "pnpm typecheck:teacher",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload",
    "test:api": "python -m pytest apps/api/tests",
    "dev:agent": "pnpm --filter @math-teacher-agent/agent dev",
    "typecheck:agent": "pnpm --filter @math-teacher-agent/agent typecheck",
    "test:agent": "pnpm --filter @math-teacher-agent/agent test",
    "build:agent": "pnpm --filter @math-teacher-agent/agent build"
  }
}
